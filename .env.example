# ==============================================================================
# Environment Configuration Template
# Copy this file to `.env` and fill in your respective API keys.
# ==============================================================================

# LLM Provider API Keys (Required for Phase 4+ Agent & Verifier nodes)
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Model Selection Override (Default: gemini-3.1-flash-lite for Gemini, claude-haiku-4-5 for Anthropic)
# COSTAWARE_AGENT_MODEL=gemini-3.1-flash-lite

# Experiment & Evaluation Defaults
DEFAULT_SEED=42
LOG_LEVEL=INFO
